# Decision model: "openai" (OpenAI Decisions API) or "typesafe" (TypeSafe Jev).
# If unset, whichever key below is present is used (TypeSafe first).
DECISIONS_PROVIDER=openai

# OpenAI Decisions API — key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com

# TypeSafe Jev — key from https://console.typesafe.ai/keys
# TYPESAFE_API_KEY=ts_...

# Optional
# DECISIONS_MODEL=gpt-6-luna          # default per provider: gpt-6-luna (openai), jev-latest (typesafe)
# DECISIONS_MAX_RPS=35                # requests per second
# DECISIONS_MAX_INFLIGHT=32           # concurrent requests
# DECISIONS_CACHE_DIR=.cache          # answers are cached by the exact request, per provider
# PORT=4317
